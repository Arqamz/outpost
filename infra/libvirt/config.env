# ─────────────────────────────────────────────────────────────────────────
# Single source of truth for the local cluster.
# Every script under infra/libvirt/ sources this file. Change values here,
# not in the scripts. All of this is safe to edit while VMs are down.
# ─────────────────────────────────────────────────────────────────────────

# --- cluster shape --------------------------------------------------------
CLUSTER_PREFIX="cluster"      # node names -> cluster-node-01 .. cluster-node-NN
CLUSTER_NODE_COUNT=8          # 8 is the tier target; drop to 4 for a safer first boot
CLUSTER_VCPUS=2               # vCPUs per VM — size so NODE_COUNT x this roughly matches your host's thread count
CLUSTER_MEM_MB=3072           # RAM per VM in MiB — size so NODE_COUNT x this leaves headroom on your host
CLUSTER_DISK_GB=20            # overlay virtual size (thin; backed by the template)

# --- networking (dedicated NAT net, isolated from libvirt's default) ------
CLUSTER_NET_NAME="cluster0"
CLUSTER_NET_BRIDGE="virbr-cluster"     # must be <= 15 chars
CLUSTER_NET_SUBNET="192.168.71"    # /24; node i -> ${SUBNET}.$((IP_BASE + i))
CLUSTER_IP_BASE=10                 # cluster-node-01 -> .11, cluster-node-08 -> .18
CLUSTER_HOST_IP="192.168.71.1"     # gateway (the host, for scp/drop-zone later)
CLUSTER_MAC_PREFIX="52:54:00:71:00" # + :NN  (52:54:00 = KVM's assigned OUI)

# --- base image (Ubuntu cloud image keeps ansible identical to cloud tiers) -
CLUSTER_OS_VARIANT="ubuntu24.04"
CLUSTER_IMAGE_URL="https://cloud-images.ubuntu.com/releases/noble/release/ubuntu-24.04-server-cloudimg-amd64.img"
CLUSTER_IMAGE_SHA256=""       # optional: paste the published SHA256SUMS entry to verify

# --- guest access ---------------------------------------------------------
CLUSTER_SSH_USER="cluster"
CLUSTER_SSH_KEY="${HOME}/.ssh/outpost-cluster-ssh"     # dedicated cluster key
CLUSTER_SSH_PUBKEY="${CLUSTER_SSH_KEY}.pub"                # injected via cloud-init
CLUSTER_SSH_PRIVKEY="${CLUSTER_SSH_KEY}"                   # used by ansible / ssh

# --- network gate ---------------------------------------------------------
# 0 = block any operation that reaches the internet (base-image download,
#     first-boot apt). Must be explicitly set to 1 (or confirmed interactively)
#     before `make template` will download or guests will apt on first boot.
CLUSTER_ALLOW_NETWORK=1

# --- firmware -------------------------------------------------------------
# Ubuntu cloud images are hybrid-boot; SeaBIOS/BIOS is simplest and needs no
# per-VM OVMF_VARS management. Set to "uefi" only if a later guest requires it.
CLUSTER_FIRMWARE="bios"

# --- host GPU node --------------------------------------------------------
# The control-plane host joins the pool as a single GPU-capable node so GPU
# jobs (gpu: true) get scheduled onto its real GPU via apptainer --nv, while
# CPU jobs run on the VMs. It is `local` (never libvirt-provisioned/destroyed).
# It is registered with CLUSTER_HOST_IP (its cluster0 bridge address) so hybrid
# jobs (hybrid: true — 1 GPU host + N-1 VMs in ONE mpirun) can point VM ranks
# at it; the host is then also the mpirun head, so it needs OpenMPI matching
# the guests' (Ubuntu 24.04: apt install openmpi-bin -> 4.1.x, same as the VMs).
CLUSTER_GPU_HOST=1                      # 1 = register the host as a GPU node
CLUSTER_HOST_NODE_NAME="cluster-host"
CLUSTER_HOST_RUNTIME="apptainer"        # container runtime used on the host

# GPU launch (apptainer --nv). NixOS keeps the driver libs outside the standard
# ldconfig path, so bind them in there; every other distro (Ubuntu etc.) wants
# this EMPTY — --nv detects the driver by itself, and a bind whose source path
# doesn't exist is a hard apptainer error. Auto-picks by probing for the NixOS
# driver dir; export CLUSTER_GPU_BINDS yourself to override either way.
if [ -d /run/opengl-driver ]; then
  CLUSTER_GPU_BINDS="${CLUSTER_GPU_BINDS-/nix/store,/run/opengl-driver}"
else
  CLUSTER_GPU_BINDS="${CLUSTER_GPU_BINDS-}"      # comma-sep extra --bind paths for GPU jobs
fi
CLUSTER_GPU_LD_LIBRARY_PATH=""          # empty = auto-detect (nvidia-smi's glibc + /run/opengl-driver/lib)

# --- Kubernetes (KAI + HAMi) backend --------------------------------------
# An OPTIONAL second execution backend: a job with `backend: k8s` in its spec
# is scheduled onto a KAI + HAMi Kubernetes cluster instead of the VMs/host —
# node_count becomes the GANG SIZE (N pods sharing the one physical GPU as
# HAMi-capped vGPU slices). The cluster + KAI + HAMi are stood up out of band by
# infra/k8s/setup.sh (see docs/08-kubernetes-backend.md); the reconciler only
# templates kubectl against it. Off by default — the VM/host pool is unaffected.
# `${VAR:-default}` (not a plain assignment) so an inherited env var wins — i.e.
# a one-off `CLUSTER_K8S_BACKEND=1 make seed-nodes` works without editing this file.
CLUSTER_K8S_BACKEND="${CLUSTER_K8S_BACKEND:-0}"        # 1 = seed k8s slots in `cluster seed-nodes`
CLUSTER_K8S_SLOTS="${CLUSTER_K8S_SLOTS:-4}"            # concurrent k8s jobs Outpost hands KAI at
                                                       # once (KAI queues the rest; a slot is a
                                                       # concurrency bound, not a physical resource)
CLUSTER_K8S_SLOT_PREFIX="${CLUSTER_K8S_SLOT_PREFIX:-k8s-slot}"   # node names: k8s-slot-0..N-1
CLUSTER_K8S_QUEUE="${CLUSTER_K8S_QUEUE:-default-queue}"          # KAI queue jobs attach to
CLUSTER_K8S_GPU_MEMORY_MB="${CLUSTER_K8S_GPU_MEMORY_MB:-2048}"   # default HAMi VRAM cap per rank
# Single-cluster kube-context baked into each slot at seed time ("" = whatever
# kube-context is current when the reconciler runs).
CLUSTER_K8S_CONTEXT="${CLUSTER_K8S_CONTEXT:-}"
# MULTI-CLUSTER: run several k8s clusters under one control plane (e.g. the VM's
# L20 + the PC's 5060 Ti). Comma-sep `name:kube_context:slots`; when set it
# OVERRIDES the single-cluster CLUSTER_K8S_SLOTS/CONTEXT above. Slots are named
# <prefix>-<name>-<i>. A job targets a cluster with params.k8s_context matching
# that kube_context; otherwise it lands on any free slot. Example:
#   CLUSTER_K8S_CLUSTERS="vm:kind-vm:8,pc:kind-pc:4"
CLUSTER_K8S_CLUSTERS="${CLUSTER_K8S_CLUSTERS:-}"

# --- qemu emulator path (baked into each domain XML) -----------------------
# Empty = auto-detect (lib.sh:qemu_emulator): NixOS system profile first, then
# the standard distro path (/usr/bin), then whatever's on PATH. Set explicitly
# only if your qemu lives somewhere unusual.
CLUSTER_QEMU_EMULATOR=""

# --- on-disk layout (all generated artifacts live here; gitignored) -------
CLUSTER_VAR_DIR="${CLUSTER_ROOT:-$(pwd)}/.var"
CLUSTER_TEMPLATE_DIR="${CLUSTER_VAR_DIR}/templates"
CLUSTER_OVERLAY_DIR="${CLUSTER_VAR_DIR}/overlays"
CLUSTER_SEED_DIR="${CLUSTER_VAR_DIR}/seeds"
CLUSTER_TEMPLATE_QCOW="${CLUSTER_TEMPLATE_DIR}/${CLUSTER_OS_VARIANT}-base.qcow2"

# Drop-zone: egress half of the open interface. Collected artifacts land in
# ${CLUSTER_DROPZONE}/<job_id>/ for whatever's driving the cluster to pick up.
CLUSTER_DROPZONE="${CLUSTER_VAR_DIR}/dropzone"
